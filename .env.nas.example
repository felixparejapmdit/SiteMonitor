# Documentation only. The wizard creates /volume1/docker/sitemonitor/.env once.
# For manual deployment replace every CHANGE_ME value; keep this file private.
# Use URL-safe letters, digits, underscores and hyphens for the database password.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_URL_SAFE_PASSWORD
SITEMONITOR_ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS
# Exactly 64 hexadecimal characters. Keep the same key for this database forever.
SITEMONITOR_DATA_KEY=CHANGE_ME_TO_64_RANDOM_HEXADECIMAL_CHARACTERS
SITEMONITOR_IMAGE=sitemonitor:local
SITEMONITOR_PORT=8737
SITEMONITOR_BIND_IP=0.0.0.0
# Set 1 after configuring HTTPS in DSM Reverse Proxy; 0 allows initial LAN setup.
SITEMONITOR_SECURE_COOKIES=0
TZ=Asia/Singapore
