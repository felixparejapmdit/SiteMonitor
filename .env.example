# Copy to .env and adjust. Every value below is also the built-in default.

# PostgreSQL connection (the dev database runs on its own port, 54329).
DATABASE_URL=postgres://sitemonitor:sitemonitor_dev@localhost:54329/sitemonitor

# The whole app (API + WebSocket + PWA) is served on this port.
PORT=8737

# Where the built Dioxus web bundle lives.
STATIC_DIR=target/dx/frontend/release/web/public

# Where uploaded 16:9 photos and base-map renders are stored.
UPLOAD_DIR=data/uploads

# Log level, e.g. backend=debug
RUST_LOG=backend=info,tower_http=warn
